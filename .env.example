# Docker Compose settings. `deno task setup` writes a .env with the first two; copy lines from here as needed.

# Host interface Docker publishes port 8787 on. 0.0.0.0 = every interface (needs credentials, which setup creates).
TTK_BIND=127.0.0.1

# The address clients use. Opens the Host and Origin allowlists to it. For LAN access: http://<host address>:8787
TTK_PUBLIC_URL=http://127.0.0.1:8787

# Optional allowlist overrides (comma-separated hostnames). Empty = derived from TTK_PUBLIC_URL.
# A value REPLACES the derived list, so include the public host. Set both or neither.
#TTK_ALLOWED_HOSTS=
#TTK_ALLOWED_ORIGINS=

# docker-compose.agents.yml (ACP bridge)
#TTK_AGENT_DEFAULT=default
#TTK_AGENT_RUNNER_IMAGE=tykotech-agent-runner:0.2.0

# docker-compose.sandbox-docker.yml (one container per workspace)
#TTK_SANDBOX_DOCKER_GID=0
#TTK_SANDBOX_WORKSPACE_IMAGE=tykotech-sandbox-workspace:0.2.0
#TTK_SANDBOX_DOCKER_VOLUME=ttk-code
#TTK_SANDBOX_DOCKER_SOCK_VOLUME=ttk-sandbox-sock

# Memory limit of the gateway container (the server plus every browser session), and the server's heap in MiB.
# TTK_GATEWAY_MEMORY=1536m
# TTK_GATEWAY_HEAP_MB=1024
