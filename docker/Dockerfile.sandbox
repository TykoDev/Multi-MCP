# A separate non-root service is the only process permitted to run bwrap.
# /run/ttk-sandbox-sock is where the opt-in Docker backend (docker-compose.sandbox-docker.yml) mounts its
# socket volume, owned by 1993 here so a fresh volume takes that owner. The default (bwrap) CMD never uses it.
# Pinned by digest to the gateway image's Deno — denoland/deno:2.9.7, resolved 2026-10-04.
ARG DENO_IMAGE=denoland/deno:2.9.7@sha256:fa335acdf6b72106eda2cb6a8cb5f4187e7630e357467489db4b2e7352d5e432
FROM ${DENO_IMAGE}
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    bubblewrap socat git python3 python3-pip nodejs npm curl ca-certificates util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /work /tmp/ttk-sandbox /run/ttk-sandbox-sock \
    && chown -R 1993:1993 /work /tmp/ttk-sandbox /run/ttk-sandbox-sock
WORKDIR /app
COPY deno.json deno.lock ./
COPY packages ./packages
COPY tests/sandbox ./tests/sandbox
COPY scripts/sandbox_healthcheck.ts ./scripts/sandbox_healthcheck.ts
RUN deno cache --frozen packages/sandbox/service.ts tests/sandbox/cages_test.ts tests/sandbox/runner_test.ts
USER 1993:1993
ENV TTK_SANDBOX_TOKEN_FILE=/run/secrets/ttk_sandbox_token DENO_NO_UPDATE_CHECK=1
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD deno run --deny-ffi --allow-net=127.0.0.1:8080 scripts/sandbox_healthcheck.ts
# Proxy DNS and validated public-IP dials require service network access.
# Every code cage remains in a fresh network namespace with only the explicit proxy socket.
# The two git names (unset, clone stays off; docker-compose.yml sets the hosts) and the remotes secret, which is
# read once at start-up and then revoked; git itself still runs only inside cages, so --allow-run stays bubblewrap
# alone.
# The token is the read-only `ttk_sandbox_token` secret (written by `deno task setup`), granted on its own and
# revoked once read (packages/sandbox/src/token.ts).
CMD ["deno", "run", "--deny-ffi", "--unstable-no-legacy-abort", "--allow-run=/usr/bin/bwrap", "--allow-read=/work,/tmp/ttk-sandbox,/run/secrets/ttk_sandbox_token,/run/secrets/ttk_git_remotes", "--allow-write=/work,/tmp/ttk-sandbox", "--allow-net", "--allow-env=TTK_SANDBOX_TOKEN_FILE,TTK_SANDBOX_GIT_HOSTS,TTK_SANDBOX_GIT_REMOTES_FILE", "--allow-sys=statfs", "packages/sandbox/service.ts"]
