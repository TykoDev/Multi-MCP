# AppArmor profile of the coding sandbox service (docker-compose.yml: `apparmor=tykotech-sandbox`).
#
# Docker's own docker-default (moby profiles/apparmor/template.go) with one change: `deny mount` becomes `mount` and
# `pivot_root`, which bubblewrap needs to build each cage's root. Under docker-default every cage, and so the service's
# start, fails with "bwrap: Failed to make / slave: Permission denied". The kernel still decides who may mount: the
# service holds no capability in the container (cap_drop ALL, no-new-privileges), so the only mount namespaces it can
# change are the ones each cage gets inside its own new user namespace.
#
# Every AppArmor host (Ubuntu, Debian, SUSE) loads it once, and again after it changes; boot reloads /etc/apparmor.d.
# `deno task setup` does that through sudo (packages/cli/apparmor.ts), whenever the installed copy differs from this
# file or is not loaded. By hand:
#
#   sudo install -m 0644 docker/apparmor-sandbox /etc/apparmor.d/tykotech-sandbox
#   sudo apparmor_parser -r /etc/apparmor.d/tykotech-sandbox
#
# Docker ignores the option on a host without AppArmor, which needs nothing.

#include <tunables/global>

profile tykotech-sandbox flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  # The one change from docker-default: bubblewrap's cage mounts, inside the cage's own user namespace.
  mount,
  pivot_root,

  # Host (privileged) processes may send signals to container processes.
  signal (receive) peer=unconfined,
  # runc may send signals to container processes (for "docker stop").
  signal (receive) peer=runc,
  # crun may send signals to container processes (for "docker stop" when used with crun OCI runtime).
  signal (receive) peer=crun,
  # dockerd may send signals to container processes (for "docker kill").
  signal (receive) peer=dockerd,
  # Container processes may send signals amongst themselves.
  signal (send,receive) peer=tykotech-sandbox,

  deny @{PROC}/* w,   # deny write for all files directly in /proc (not in a subdir)
  # deny write to files not in /proc/<number>/** or /proc/sys/**
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,  # deny /proc/sys except /proc/sys/k* (effectively /proc/sys/kernel)
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,  # deny everything except shm* in /proc/sys/kernel/
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  # suppress ptrace denials when using 'docker ps' or using 'ps' inside a container
  ptrace (trace,read,tracedby,readby) peer=tykotech-sandbox,
}
